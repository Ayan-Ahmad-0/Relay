# Database (PostgreSQL 16)
DATABASE_URL=postgres://relay:relay@localhost:5432/relay_dev?sslmode=disable
TEST_DATABASE_URL=postgres://relay:relay@localhost:5432/relay_test?sslmode=disable

# External Deduplicating Sink Service
SINK_URL=http://localhost:8001/sink
SINK_PORT=8001

# Clearance (Project 1) Service Principal
CLEARANCE_URL=http://localhost:8002
CLEARANCE_API_KEY=test-clearance-key
CLEARANCE_CACHE_DIR=./cache/clearance

# Ledgerline (Project 2) Service
LEDGERLINE_URL=http://localhost:8003
LEDGERLINE_API_KEY=test-ledgerline-key

# Host Helpdesk (Chatwoot)
HOST_HELPDESK_URL=http://localhost:3000
HOST_HELPDESK_API_KEY=test-chatwoot-token
HOST_ACCOUNT_ID=1

# Execution & Concurrency Settings
WORKER_POLL_INTERVAL_MS=500
LEASE_DURATION_SECONDS=30
MAX_RETRIES=5
